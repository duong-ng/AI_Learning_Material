# -----------------------------------------------------------------------------
# AI Olympiad Platform - Environment Configuration Template
# Sao chép file này thành .env và điền các khóa bí mật của bạn
# LƯU Ý: Không bao giờ commit file .env chứa khóa thật lên GitHub!
# -----------------------------------------------------------------------------

# Đường dẫn cơ sở dữ liệu SQLite cục bộ
DATABASE_URL="file:./dev.db"

# Khóa API OpenRouter để kích hoạt Trợ lý AI Nemotron-3 Ultra 550B
# Lấy API key miễn phí tại: https://openrouter.ai/keys
OPENROUTER_API_KEY="your-openrouter-api-key-here"

# Model AI sử dụng (mặc định Nemotron-3 Ultra 550B Reasoning)
OPENROUTER_MODEL="nvidia/nemotron-3-ultra-550b-a55b:free"
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"

# Giới hạn token sinh ra tối đa cho lời giải chuyên sâu (khuyến nghị 4096)
OPENROUTER_MAX_TOKENS="4096"
